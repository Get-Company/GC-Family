# GC-Family — Beispiel-Umgebungsvariablen.
# Kopieren nach .env und Werte anpassen. .env wird NICHT eingecheckt.

# --- Django ---
# Für die Produktion einen zufälligen, geheimen Wert setzen:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=bitte-aendern
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend-Origin(s), die die API ansprechen dürfen.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Datenbank (Postgres, im Docker-Betrieb) ---
DB_NAME=gcfamily
DB_USER=gcfamily
DB_PASSWORD=changeme
# DB_HOST/DB_PORT werden im docker-compose gesetzt (db:5432).
# Lokal ohne DB_HOST fällt Django automatisch auf SQLite zurück.
